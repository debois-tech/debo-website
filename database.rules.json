{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "team":     { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "programs": { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "openings": { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "posts":    { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },

    "drafts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "images": {
      "$id": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "full": { ".validate": "newData.isString() && newData.val().length < 14000000" },
        "thumb": { ".validate": "newData.isString() && newData.val().length < 3000000" }
      }
    }
  }
}
