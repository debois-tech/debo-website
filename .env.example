# Resend (https://resend.com). Server-side only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Comma-separated recipients for website enquiries
ENQUIRY_TO_EMAIL=hello@deboistech.in
# Must be on a domain verified in Resend, e.g. "DeboisTech Website <website@deboistech.in>"
ENQUIRY_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=https://www.deboistech.in

# --- Debo chatbot (server-only; never prefix with NEXT_PUBLIC_) ---
# Google AI Studio key. Without it the chatbot answers from the offline knowledge base.
GEMINI_API_KEY=
CHATBOT_MODEL=gemini-2.5-flash
# Google Sheets storage via the Apps Script web app (see docs/chatbot-setup.md). Without both, enquiries are written to .data/enquiries.json.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=
# Who receives enquiry emails (comma separated). Defaults to adityabankar@ and harshadgangurde@deboistech.in.
ENQUIRY_NOTIFY_EMAILS=

# Optional JSON webhook for enquiry notifications. When empty, FormSubmit emails hello@deboistech.in.
LEAD_WEBHOOK_URL=
