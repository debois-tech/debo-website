# Resend (https://resend.com). Server-side only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Comma-separated recipients for website enquiries
ENQUIRY_TO_EMAIL=hello@deboistech.in
# Must be on a domain verified in Resend, e.g. "DeboisTech Website <website@deboistech.in>"
ENQUIRY_FROM_EMAIL=[EMAIL_ADDRESS]
NEXT_PUBLIC_SITE_URL=https://www.deboistech.in

# Booking link for calls (Cal.com, Calendly, Google Calendar…). Shown on /contact when set.
NEXT_PUBLIC_BOOKING_URL=
